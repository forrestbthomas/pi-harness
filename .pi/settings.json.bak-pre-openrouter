{
  "defaultProvider": "moonshotai",
  "defaultModel": "kimi-k3",
  "defaultThinkingLevel": "medium",
  "theme": "dark",
  "quietStartup": false,
  "collapseChangelog": false,
  "doubleEscapeAction": "tree",
  "treeFilterMode": "default",
  "showHardwareCursor": false,
  "terminal": {
    "showImages": true,
    "imageWidthCells": 60,
    "clearOnShrink": false
  },
  "images": {
    "autoResize": true,
    "blockImages": false
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "provider": {
      "timeoutMs": 3600000,
      "maxRetries": 0,
      "maxRetryDelayMs": 60000
    }
  },
  "steeringMode": "one-at-a-time",
  "followUpMode": "one-at-a-time",
  "transport": "sse",
  "sessionDir": ".pi/sessions",
  "enabledModels": [
    "kimi-coding/*",
    "claude-*",
    "gpt-4o*",
    "gemini-2*"
  ],
  "warnings": {
    "anthropicExtraUsage": true
  },
  "markdown": {
    "codeBlockIndent": "  "
  },
  "enableSkillCommands": true,
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:pi-web-access",
    "npm:@demigodmode/pi-web-agent",
    "npm:@loreai/pi",
    "npm:pi-spark",
    "git:github.com/dannote/dot-pi"
  ],
  "extensions": [],
  "skills": [],
  "prompts": [],
  "themes": []
}
