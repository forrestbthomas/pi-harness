# Copy this file to .env and fill in your API key(s).
# Keys are normally resolved from Bitwarden via ~/bin/bw_get (folder
# "Dev API Keys", item name == env var name); conftest.get_secret() checks the
# env var first, then falls back to bw_get. Only set keys here to override.
# DeepEval uses OPENAI_API_KEY by default for LLM-as-a-judge metrics.
OPENAI_API_KEY=sk-...

# Optional: use a different model for DeepEval evaluations.
# DEEPEVAL_MODEL=gpt-4o-mini

# Pi provider API keys (pick one or more).
# OPENROUTER_API_KEY=sk-or-v1-...   # preferred: route via OpenRouter (default model openai/gpt-4o)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
